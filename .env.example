# ===========================================
# OpenTrading Environment Configuration
# Copy this file to .env and fill in your values
# cp .env.example .env
# ===========================================

# --- Optional API Keys ---
# DeepSeek AI (https://platform.deepseek.com/)
DEEPSEEK_API_KEY=

# --- Database ---
# Required. OpenTrading uses DATABASE_URL as the only database boundary.
# Server deployments should use PostgreSQL, for example:
# DATABASE_URL=postgresql://user:password@localhost:5432/opentrading
DATABASE_URL=

# --- Redis (optional, will degrade gracefully if unavailable) ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Server ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:8000,http://127.0.0.1:8000
# API and background runtime run as separate processes by default.
APP_RUNTIME_ROLE=api

# --- Logging ---
LOG_LEVEL=INFO
# Set to enable file logging (e.g., logs/opentrading.log)
LOG_FILE=

# --- Runtime files ---
# Defaults to .opentrading_runtime/ under the project root to avoid writing large
# runtime files to the system drive. Override all related paths together
# if you want them on another disk.
# RUNTIME_ROOT_DIR=D:/OpenTradingRuntime
# LOG_DIR=D:/OpenTradingRuntime/logs
# TEMP_DIR=D:/OpenTradingRuntime/tmp

# --- Rate Limiting ---
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_HEAVY=10/minute

# --- Advanced (usually no need to change) ---
# EXCHANGE_MAX_RETRIES=3
# EXCHANGE_RETRY_DELAY=2
# EXCHANGE_TASK_TIMEOUT=90
# EXCHANGE_FETCH_LIMIT=1000
# REDIS_KLINE_TTL=300
# WS_UPDATE_INTERVAL=5
# API_MAX_LIMIT=5000
# HISTORY_DEFAULT_LIMIT=500
# INDICATORS_DEFAULT_DAYS=30
# DCA_CACHE_TTL=600
# LLM_TEMPERATURE=0.1
# LLM_REQUEST_TIMEOUT=30.0
# MARKET_CRON_INTERVAL_HOURS=4
# RESEARCH_ALERT_INTERVAL_SECONDS=60
# TRADE_SIGNAL_EVALUATION_INTERVAL_SECONDS=300
# KLINE_RETENTION_DAYS=365
